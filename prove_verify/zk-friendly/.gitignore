# zk-friendly (Circom + snarkjs) — project-specific ignores.
# OS metadata, editor files, and node_modules/ are covered by the root .gitignore.

# Deps are pinned in package.json and re-resolved at install time (Docker too).
package-lock.json

# Circom / Groth16 build outputs (regenerated by the bench scripts).
**/generated/

# Auto-generated circuits for the merkle-vs-flat sweep.
merkle_vs_flat_bench/merkle_t*_u*.circom
merkle_vs_flat_bench/flat_t*_u*.circom

# Benchmark run artifacts. Summary JSONs (summary_*.json) live under these dirs;
# the bench scripts auto-clean everything else unless --keep-artifacts is set.
artifacts_bench_*/

# Local ptau download (the Dockerfile COPY expects the file at build time).
powersOfTau/*.ptau
